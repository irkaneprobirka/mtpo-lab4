{
  "name": "js-test-framework-benchmark",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "verify": "node src/benchmark.js --verify --input data/reference-input.json --expected data/reference-output.json",
    "benchmark": "node src/benchmark.js --input data/author-example.json --runs 3",
    "benchmark:csv": "node src/benchmark.js --input data/author-example.csv --runs 3",
    "test:jest": "jest tests/jest --runInBand",
    "test:vitest": "vitest run tests/vitest --pool=threads",
    "test:mocha": "mocha tests/mocha/**/*.test.js"
  },
  "dependencies": {
    "pidusage": "^3.0.2"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "mocha": "^11.0.0",
    "vitest": "^3.0.0"
  }
}
