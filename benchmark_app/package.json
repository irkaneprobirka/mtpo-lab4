{
  "name": "js-test-framework-benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "node src/benchmark.js --verify --input data/reference_input.json --expected data/reference_output.json",
    "benchmark": "node src/benchmark.js",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/jest --runInBand",
    "test:vitest": "vitest run tests/vitest --pool=threads",
    "test:mocha": "mocha tests/mocha/**/*.test.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "chai": "^5.2.0",
    "jest": "^30.0.0",
    "mocha": "^11.0.0",
    "vitest": "^3.0.0"
  }
}
