{
  "name": "js-test-framework-benchmark",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js",
    "demo": "node src/cli.js --file data/example.json",
    "verify": "node src/verify.js",
    "generate": "node scripts/generate.js",
    "test": "npm run test:jest && npm run test:mocha && npm run test:vitest",
    "test:jest": "jest --runInBand",
    "test:mocha": "mocha tests/mocha/*.test.js",
    "test:vitest": "vitest run",
    "benchmark": "node scripts/python.js benchmark",
    "benchmark:quick": "node scripts/python.js benchmark --input data/size-100.json --runs 1",
    "test:quality": "node scripts/python.js quality",
    "results": "node scripts/results.js"
  },
  "devDependencies": {
    "chai": "6.2.2",
    "jest": "30.0.5",
    "mocha": "11.7.1",
    "vitest": "3.2.4"
  }
}
